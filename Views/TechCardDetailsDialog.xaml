<Window x:Class="MenuStolovaya.Views.TechCardDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали технологической карты" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   x:Name="TitleText"
                   Style="{StaticResource SubtitleStyle}"
                   Margin="0,0,0,15"/>

        <!-- Основная информация -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardStyle}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Номер карты:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CardNumberText" VerticalAlignment="Center" Margin="5" FontWeight="Bold"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Блюдо:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DishText" VerticalAlignment="Center" Margin="5" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Вид блюда:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DishTypeText" VerticalAlignment="Center" Margin="5"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Выход:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="OutputText" VerticalAlignment="Center" Margin="5" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Статус:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="StatusText" VerticalAlignment="Center" Margin="5" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Дата создания:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="CreationDateText" VerticalAlignment="Center" Margin="5"/>
            </Grid>
        </Border>

        <!-- Рецептура -->
        <Border Grid.Row="2" 
                Style="{StaticResource CardStyle}" 
                Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Рецептура" FontWeight="SemiBold" Margin="5"/>
                <DataGrid x:Name="RecipesGrid" 
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="5"
                          Height="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Порядок" Binding="{Binding Порядок_закладки}" Width="60"/>
                        <DataGridTextColumn Header="Артикул" Binding="{Binding Артикул}" Width="100"/>
                        <DataGridTextColumn Header="Продукт" Binding="{Binding Продукт}" Width="200"/>
                        <DataGridTextColumn Header="Ед. изм." Binding="{Binding Единица_измерения}" Width="80"/>
                        <DataGridTextColumn Header="Кол-во (кг)" Binding="{Binding Количество_брутто, StringFormat={}{0:F3}}" Width="100"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Цена, StringFormat={}{0:N2} руб.}" Width="100"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Сумма, StringFormat={}{0:N2} руб.}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Технология приготовления -->
        <Border Grid.Row="3" 
                Style="{StaticResource CardStyle}" 
                Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Технология приготовления:" FontWeight="SemiBold" Margin="5"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="5">
                    <TextBlock x:Name="TechnologyText" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Кнопки -->
        <Border Grid.Row="4" 
                Style="{StaticResource CardStyle}" 
                Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Печать" Style="{StaticResource PrimaryButtonStyle}" Width="100" Click="PrintButton_Click" Margin="5"/>
                <Button Content="Закрыть" Style="{StaticResource PrimaryButtonStyle}" Background="{StaticResource AccentDarkBrush}" Width="100" Click="CloseButton_Click" Margin="5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>